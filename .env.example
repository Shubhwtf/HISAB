ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=hisab_super_secret_production_ready_key_change_in_prod
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL=postgresql+asyncpg://hisab_user:hisab_password@localhost:5432/hisab
SYNC_DATABASE_URL=postgresql+psycopg://hisab_user:hisab_password@localhost:5432/hisab
REDIS_URL=redis://localhost:6379/0
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=10
CRITICAL_EXPOSURE_THRESHOLD_PAISE=10000000
HIGH_EXPOSURE_THRESHOLD_PAISE=2500000
MEDIUM_EXPOSURE_THRESHOLD_PAISE=500000
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.95
AUTO_RESOLVE_MAX_EXPOSURE_PAISE=500000
AUTO_RESOLVE_MIN_EVIDENCE_COUNT=2
DEFAULT_MDR_BPS=200
DEFAULT_GST_BPS=1800
