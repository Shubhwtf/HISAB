# ==============================================================================
# HISAB — AI Finance Controller for Razorpay
# Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=hisab_super_secret_production_ready_key_change_in_prod

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Cache (Authoritative Production PostgreSQL + Redis)
# Async driver: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Sync driver: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://hisab_user:hisab_password@localhost:5432/hisab
SYNC_DATABASE_URL=postgresql+psycopg://hisab_user:hisab_password@localhost:5432/hisab
# For isolated local unit testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///data/generated/hisab.db
# SYNC_DATABASE_URL=sqlite:///data/generated/hisab.db
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Live / Test Credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# AI & LLM Provider Configuration (Groq / Gemini)
LLM_PROVIDER=groq  # Options: groq, gemini, mock
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=llama-3.3-70b-versatile  # Groq: llama-3.3-70b-versatile | Gemini: gemini-2.0-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=10

# Financial Control Thresholds (Minor units: Paise)
# Critical: ₹1,00,000 (10000000 paise)
CRITICAL_EXPOSURE_THRESHOLD_PAISE=10000000
# High: ₹25,000 (2500000 paise)
HIGH_EXPOSURE_THRESHOLD_PAISE=2500000
# Medium: ₹5,000 (500000 paise)
MEDIUM_EXPOSURE_THRESHOLD_PAISE=500000

# Safe Auto-Resolution Policy
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.95
AUTO_RESOLVE_MAX_EXPOSURE_PAISE=500000  # Max ₹5,000 for auto-resolve
AUTO_RESOLVE_MIN_EVIDENCE_COUNT=2

# Default Scenario Financial Parameters (Base basis points: 200 = 2.0%)
DEFAULT_MDR_BPS=200
DEFAULT_GST_BPS=1800  # 18% GST on fees
